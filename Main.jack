class Main{
    function void main(){
        var int score;
        var int cact1L , dinoRx , dinofeet, vel, cact2L;
        var char key;
        let dinoRx = 30;
        let cact1L= 180;

        let cact2L= 280;
        let dinofeet = 200;
        let vel = 8;
        

        do Screen.drawLine(0, 200, 510, 200);
  
        
        do Screen.drawRectangle(cact1L, 160, cact1L + 10, 200);
        do Screen.drawRectangle(cact2L, 160,cact2L +10 , 200);
       

        do Screen.drawRectangle(10,dinofeet - 20, dinoRx, dinofeet);

        do Sys.wait(1000);
        while(true ){
            do Screen.setColor(false);
            do Screen.drawRectangle(cact1L, 160, cact1L + 10, 199);
            do Screen.drawRectangle(cact2L, 160, cact2L + 10, 199);
            

            let cact1L = cact1L - 4;  
            
            let cact2L = cact2L - 4;    

            do Screen.setColor(true);
            do Screen.drawRectangle(cact1L, 160, cact1L + 10, 199);
            do Screen.drawRectangle(cact2L, 160, cact2L + 10, 199);
            
            
            let key = Keyboard.keyPressed();
            if (key = 32){
                do Screen.setColor(false);
                do Screen.drawRectangle(10,dinofeet - 20, dinoRx, dinofeet);

                let dinofeet= dinofeet - vel;
                do Screen.setColor(true);
                do Screen.drawRectangle(10,dinofeet - 20, dinoRx, dinofeet);
            }

            if(dinofeet < 200 & ~(key = 32)){//gravity
                do Screen.setColor(false);
                do Screen.drawRectangle(10,dinofeet - 20, dinoRx, dinofeet);

                let dinofeet= dinofeet + 3;
                do Screen.setColor(true);
                do Screen.drawRectangle(10,dinofeet - 20, dinoRx, dinofeet);
            }
            do Sys.wait(1);//lag

            

            

            let score = score + 1;


            if((cact1L < dinoRx & dinofeet > 160)|(cact1L < dinoRx & dinofeet > 160)){
                do Output.moveCursor(10, 27);
        
                do Output.printString("GAME OVER, SCORE : ");
                do Output.printInt(score);
                return;
            }

            if(cact1L < 1){
                do Screen.setColor(false);
                do Screen.drawRectangle(cact1L, 160, cact1L + 10, 199);
                do Screen.setColor(true);
                let cact1L = 500;
                
            }
            
            if(cact2L < 1){
                do Screen.setColor(false);
                do Screen.drawRectangle(cact2L, 160, cact2L + 10, 199);
                do Screen.setColor(true);
                let cact2L = 500;
                
            }
        }
    return;
    }
}   
